{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.djrobson5/agentmd",
  "description": "Convert PDF, DOCX, HTML, and URLs to clean, LLM-ready markdown with tables preserved",
  "repository": {
    "url": "https://github.com/djrobson5/agentmd-mcp",
    "source": "github"
  },
  "version": "0.1.1",
  "websiteUrl": "https://www.getagentmd.com",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "agentmd-mcp",
      "version": "0.1.1",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "AGENTMD_API_KEY",
          "description": "API key from https://www.getagentmd.com",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "AGENTMD_BASE_URL",
          "description": "Override the API base URL (self-hosting or staging)",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://www.getagentmd.com/api/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <your AgentMD API key>",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
